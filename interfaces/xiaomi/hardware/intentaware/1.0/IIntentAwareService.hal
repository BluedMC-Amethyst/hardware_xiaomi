package vendor.xiaomi.hardware.intentaware@1.0;

import IEventCallback;

interface IIntentAwareService {
    oneway sendMessage(int32_t type, string payload);
    registerReceiver(int32_t type, IEventCallback callback)
        generates (int64_t token);
    oneway unregisterReceiver(int64_t token);
};
